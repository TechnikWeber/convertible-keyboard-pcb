	(text "ANSI alternatives - populate instead of the matching ISO keys\nSW106  Backslash 1.5u: no LED, switch rotated 270° on the PCB (clears the ISO Enter stabilizer)\nSW107  Enter 2.25u: same matrix position as ISO Enter SW71 (ROW3 / COL13)\nSW108  Left Shift 2.25u: same matrix position as ISO Left Shift SW75 (ROW4 / COL0)\nSW71 is drawn rotated 180°: pin 2 = COL13, pin 1 = diode (keeps its pads clear of SW106)"
		(exclude_from_sim no)
		(at 302.26 12.7 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
